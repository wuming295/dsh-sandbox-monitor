{
  "name": "dsh-sandbox-monitor",
  "version": "0.1.0",
  "description": "Real-time sandbox observability for DeepSeek Harness: latency, loss, errors, tokens, CPU and a live sandbox preview in the native right sidebar.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "author": "YAKUMI <2741693175@qq.com>",
  "engines": {
    "node": ">=20"
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sandbox",
    "monitor",
    "observability",
    "metrics",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuming295/dsh-sandbox-monitor.git"
  },
  "homepage": "https://github.com/wuming295/dsh-sandbox-monitor#readme",
  "bugs": {
    "url": "https://github.com/wuming295/dsh-sandbox-monitor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-client-runtime": ">=0.2.0-rc.2 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <2",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "prepack": "npm run check"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
